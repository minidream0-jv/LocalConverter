<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Converter.App</AssemblyName>
    <RootNamespace>LocalConverter.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Conversion.Core\Conversion.Core.csproj" />
    <ProjectReference Include="..\Conversion.Images\Conversion.Images.csproj" />
    <ProjectReference Include="..\Conversion.FFmpeg\Conversion.FFmpeg.csproj" />
  </ItemGroup>
</Project>
