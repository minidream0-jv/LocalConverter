<Window x:Class="LocalConverter.App.ConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Другой формат" Height="650" Width="520"
        MinHeight="500" MinWidth="470" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Другой формат" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceSummary" Margin="0,5,0,0" Foreground="#666666" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Выходной формат" Margin="0,0,0,5" />
                <ComboBox x:Name="FormatBox" SelectionChanged="FormatBox_OnSelectionChanged" />

                <TextBlock Text="Папка сохранения" Margin="0,14,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" Click="Browse_OnClick" />
                </Grid>

                <TextBlock Text="Качество" Margin="0,14,0,3" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="85" TickFrequency="5" />
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="ImageOptions" Visibility="Collapsed">
                    <TextBlock Text="Размер изображения" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ширина" Margin="0,0,0,4" />
                            <TextBox x:Name="ImageWidthBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Высота" Margin="0,0,0,4" />
                            <TextBox x:Name="ImageHeightBox" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="PreserveAspectBox" Content="Сохранять пропорции" IsChecked="True" Margin="0,10,0,0" />
                    <CheckBox x:Name="PreserveTransparencyBox" Content="Сохранять прозрачность, если формат позволяет" IsChecked="True" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel x:Name="VideoOptions" Visibility="Collapsed">
                    <TextBlock Text="Параметры видео" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <UniformGrid Columns="2" Rows="3">
                        <StackPanel Margin="0,0,6,10"><TextBlock Text="Разрешение (ширина)" Margin="0,0,0,4"/><TextBox x:Name="VideoWidthBox" /></StackPanel>
                        <StackPanel Margin="6,0,0,10"><TextBlock Text="Разрешение (высота)" Margin="0,0,0,4"/><TextBox x:Name="VideoHeightBox" /></StackPanel>
                        <StackPanel Margin="0,0,6,10"><TextBlock Text="FPS" Margin="0,0,0,4"/><TextBox x:Name="FpsBox" /></StackPanel>
                        <StackPanel Margin="6,0,0,10"><TextBlock Text="Видеокодек" Margin="0,0,0,4"/><ComboBox x:Name="VideoCodecBox" IsEditable="True"><ComboBoxItem Content="Авто"/><ComboBoxItem Content="libx264"/><ComboBoxItem Content="libx265"/><ComboBoxItem Content="libvpx-vp9"/></ComboBox></StackPanel>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Видеобитрейт" Margin="0,0,0,4"/><TextBox x:Name="VideoBitrateBox" ToolTip="Например, 6M" /></StackPanel>
                        <StackPanel Margin="6,0,0,0"><TextBlock Text="Аудиокодек" Margin="0,0,0,4"/><ComboBox x:Name="VideoAudioCodecBox" IsEditable="True"><ComboBoxItem Content="Авто"/><ComboBoxItem Content="aac"/><ComboBoxItem Content="libopus"/><ComboBoxItem Content="copy"/></ComboBox></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Аудиобитрейт" Margin="0,10,0,4" />
                    <TextBox x:Name="VideoAudioBitrateBox" Text="192k" />
                </StackPanel>

                <StackPanel x:Name="AudioOptions" Visibility="Collapsed">
                    <TextBlock Text="Параметры аудио" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <UniformGrid Columns="3" Rows="1">
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Битрейт" Margin="0,0,0,4"/><TextBox x:Name="AudioBitrateBox" Text="192k" /></StackPanel>
                        <StackPanel Margin="6,0,6,0"><TextBlock Text="Частота" Margin="0,0,0,4"/><ComboBox x:Name="SampleRateBox" IsEditable="True"><ComboBoxItem Content="Авто"/><ComboBoxItem Content="44100"/><ComboBoxItem Content="48000"/></ComboBox></StackPanel>
                        <StackPanel Margin="6,0,0,0"><TextBlock Text="Каналы" Margin="0,0,0,4"/><ComboBox x:Name="ChannelsBox"><ComboBoxItem Content="Авто"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666666" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Отмена" Margin="8,0" Click="Cancel_OnClick" />
            <Button x:Name="ConvertButton" Grid.Column="2" Content="Конвертировать" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="#005A9E" Click="Convert_OnClick" />
        </Grid>
    </Grid>
</Window>

