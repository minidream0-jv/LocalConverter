<Window x:Class="LocalConverter.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Local Converter"
        Width="640" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14" Background="#F3F3F3">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="#E5F1FB" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StepRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="InstallPanel" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Local Converter" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Локальная конвертация из Проводника Windows 11"
                           Margin="0,8,0,0" Foreground="#5F5F5F" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Приложение и FFmpeg будут установлены автоматически. После установки конвертер появится в меню, которое открывается правой кнопкой мыши по файлу."
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,18,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Отмена" Width="96" Height="38"
                        Margin="0,0,10,0" Click="Cancel_OnClick" />
                <Button x:Name="InstallButton" Content="Установить"
                        Style="{StaticResource PrimaryButton}" Click="Install_OnClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="UsagePanel" Margin="32,26,32,28" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#107C10"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock Text="✓" Foreground="White" FontSize="25" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Установка завершена" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Открывать программу отдельно не нужно"
                               Margin="0,4,0,0" Foreground="#5F5F5F" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,20,0,18" Padding="14,11"
                    CornerRadius="8" Background="#E5F1FB" BorderBrush="#C7E0F4" BorderThickness="1">
                <TextBlock Text="Файл  →  правая кнопка мыши  →  Конвертировать  →  нужный формат"
                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="#E1E1E1" BorderThickness="1" Padding="20,18,20,4">
                <StackPanel>
                    <Grid Style="{StaticResource StepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Найдите файл" FontWeight="SemiBold" />
                            <TextBlock Text="В Проводнике Windows или прямо на рабочем столе." Foreground="#5F5F5F" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource StepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Нажмите по файлу правой кнопкой мыши" FontWeight="SemiBold" />
                            <TextBlock Text="Откроется обычное меню Windows 11." Foreground="#5F5F5F" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource StepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Найдите пункт «Конвертировать»" FontWeight="SemiBold" />
                            <TextBlock Text="Нажмите на него или наведите курсор — откроется список форматов." Foreground="#5F5F5F" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource StepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Выберите нужный формат" FontWeight="SemiBold" />
                            <TextBlock Text="Например: JPG, PNG, WEBP, MP4 или MP3." Foreground="#5F5F5F" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource StepRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Готово" FontWeight="SemiBold" />
                            <TextBlock Text="Новый файл появится рядом с исходным. Исходный файл не удаляется и не изменяется." Foreground="#5F5F5F" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#5F5F5F" TextWrapping="Wrap" Margin="0,0,20,0"
                           Text="Можно выделить сразу несколько файлов. Для дополнительных настроек выберите «Другой формат…»." />
                <Button x:Name="DoneButton" Grid.Column="1" Content="Понятно, завершить"
                        Style="{StaticResource PrimaryButton}" Click="Done_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
